{
  "name": "@phosphor/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm --prefix ../shared run build",
    "dev": "cross-env NEXT_PUBLIC_DATA=api next dev",
    "prebuild": "npm --prefix ../shared run build",
    "build": "next build && node scripts/relativize.mjs",
    "prebuild:sinapsis": "npm --prefix ../shared run build",
    "build:sinapsis": "cross-env NEXT_PUBLIC_DATA=offline next build && node scripts/relativize.mjs",
    "pretest": "npm --prefix ../shared run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0"
  },
  "dependencies": {
    "@phosphor/shared": "*",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
